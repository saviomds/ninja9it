<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body class="page-inner auth-page">

<%- include('partials/splash') %>
<%- include('partials/navbar') %>

<section class="auth-section">
  <div class="auth-card">

    <div class="auth-logo">
      <img src="/logo.jpg" alt="Ninja9IT" />
      <h1>NINJA<em>9</em>IT</h1>
      <p>Shadow login — enter the dojo.</p>
    </div>

    <% if (error) { %>
    <div class="auth-alert auth-alert--error"><span>✕</span> <%= error %></div>
    <% } %>

    <form class="auth-form" method="POST" action="/login" id="loginForm">
      <div class="auth-group">
        <label>Username or Email</label>
        <input type="text" name="username" placeholder="Your username or email"
          required autofocus autocomplete="username" />
      </div>
      <div class="auth-group">
        <label>Password</label>
        <div class="pw-wrap">
          <input type="password" name="password" placeholder="Your secret password"
            required autocomplete="current-password" />
          <button type="button" class="pw-toggle" aria-label="Show password" tabindex="-1">👁</button>
        </div>
      </div>
      <button type="submit" class="auth-btn" id="loginBtn">
        <span>Enter the Dojo</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </button>
    </form>

    <div class="auth-divider"></div>

    <p class="auth-switch">No account yet? <a href="/register">Create one →</a></p>
    <p class="auth-notice">⚡ Accounts auto-expire after 48 hours. Admin accounts are permanent.</p>

  </div>
</section>

<% if (locals.success) { %>
<div class="auth-success-overlay" id="loginSuccess">
  <div class="auth-success-card">
    <span class="asc-avatar"><%= locals.welcomeAvatar || '🥷' %></span>
    <span class="asc-tick">✅</span>
    <h2>Welcome back, <span><%= locals.welcomeUser || '' %></span>!</h2>
    <p class="asc-sub">You're in the dojo. Here's what you can do:</p>
    <div class="asc-guide">
      <div class="asc-guide-item">🍺 Browse the menu and add to cart</div>
      <div class="asc-guide-item">📍 Track your orders in real-time</div>
      <div class="asc-guide-item">🥷 View your mission history</div>
    </div>
    <p class="asc-redirect">Heading to home base…</p>
    <div class="asc-bar"><div class="asc-bar-fill" id="ascFill"></div></div>
  </div>
</div>
<script>
(function(){
  var fill = document.getElementById('ascFill');
  var start = Date.now(), dur = 2800;
  function tick() {
    var p = Math.min(100, (Date.now()-start)/dur*100);
    fill.style.width = p + '%';
    if (p < 100) requestAnimationFrame(tick);
    else window.location.href = '/';
  }
  requestAnimationFrame(tick);
})();
</script>
<% } %>

<%- include('partials/footer') %>
<%- include('partials/callwidget') %>
<script src="/js/main.js"></script>
</body>
</html>
