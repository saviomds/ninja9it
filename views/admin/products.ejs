<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="admin-body">
<div class="admin-layout">
  <%- include('partials/sidebar') %>

  <main class="admin-main">
    <div class="admin-topbar">
      <div class="admin-topbar-title">🍺 Products</div>
      <div class="admin-topbar-right">
        <input class="admin-search" id="searchInput" placeholder="🔍 Search products…" oninput="filterCards()" />
        <a href="/admin/products/new" class="btn-admin primary sm">➕ Add Product</a>
      </div>
    </div>

    <div class="admin-content">

      <!-- Custom Products -->
      <div class="admin-section-header">
        <h2>Custom Products <span style="color:#555;font-size:.8rem;font-weight:400">(<%= customProducts.length %>) — editable</span></h2>
      </div>

      <% if (!customProducts.length) { %>
      <div class="admin-empty" style="background:#111;border:1px dashed #222;border-radius:13px;margin-bottom:22px">
        <div class="empty-icon">📦</div>
        <p>No custom products yet. <a href="/admin/products/new" style="color:#e63946">Add the first one →</a></p>
      </div>
      <% } else { %>
      <div class="admin-products-grid" id="customGrid">
        <% customProducts.forEach(function(p) { %>
        <div class="admin-product-card product-card" data-search="<%= (p.name+p.category+(p.tag||'')).toLowerCase() %>">
          <div class="apc-visual" style="background:<%= p.gradient || 'linear-gradient(135deg,#1a1a1a,#333)' %>">
            <% if (p.image) { %><img src="<%= p.image %>" alt="<%= p.name %>" />
            <% } else { %><span class="apc-emoji"><%= p.emoji || '📦' %></span><% } %>
            <span class="apc-custom-badge">Custom</span>
          </div>
          <div class="apc-info">
            <div class="apc-cat"><%= p.category %></div>
            <div class="apc-name"><%= p.name %></div>
            <div class="apc-price">Rs <%= p.price %></div>
            <div style="font-size:.72rem;color:#555;margin-bottom:8px"><%= p.tag %></div>
            <div class="apc-actions">
              <a href="/admin/products/<%= p.id %>/edit" class="btn-admin ghost sm">✏️ Edit</a>
              <button type="button" class="btn-admin danger sm"
                data-id="<%= p.id %>" data-name="<%= p.name %>"
                onclick="openDelModal(this.dataset.id,this.dataset.name,this.closest('.admin-product-card'))">🗑 Delete</button>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
      <% } %>

      <!-- Built-in Products by Category -->
      <% categories.forEach(function(cat) {
           const visibleItems = builtInItems[cat].filter(function(p) { return !deletedBuiltins.includes(p.id); });
      %>
      <div class="admin-section-header" style="margin-top:12px">
        <h2><%= categoryMeta[cat].emoji %> <%= categoryMeta[cat].label %>
          <span style="color:#555;font-size:.8rem;font-weight:400">(<%= visibleItems.length %>) — built-in</span>
        </h2>
      </div>
      <% if (!visibleItems.length) { %>
      <div class="admin-empty" style="background:#111;border:1px dashed #222;border-radius:13px;margin-bottom:22px">
        <div class="empty-icon">🗑</div>
        <p style="color:#555">All products in this category have been deleted.</p>
      </div>
      <% } else { %>
      <div class="admin-products-grid">
        <% visibleItems.forEach(function(p) { %>
        <div class="admin-product-card product-card" data-id="<%= p.id %>"
             data-search="<%= (p.name+p.category+(p.tag||'')).toLowerCase() %>">
          <div class="apc-visual" style="background:<%= p.gradient %>; position:relative; overflow:hidden">
            <% if (overrides[p.id] && overrides[p.id].image) { %>
            <img src="<%= overrides[p.id].image %>" alt="<%= p.name %>"
              style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
            <% } else { %>
            <span class="apc-emoji builtin-emoji"><%= p.emoji %></span>
            <% } %>
          </div>
          <div class="apc-info">
            <div class="builtin-badge">Built-in</div>
            <div class="apc-name"><%= p.name %></div>
            <div class="apc-price">Rs <%= p.price %></div>
            <div style="font-size:.72rem;color:#555;margin-bottom:8px"><%= p.tag %></div>
            <div class="apc-actions" style="flex-wrap:wrap;gap:5px">
              <label class="btn-admin ghost sm" style="cursor:pointer;margin:0" title="Upload image">
                📸
                <input type="file" accept="image/*" style="display:none"
                  onchange="uploadBuiltinImage('<%= p.id %>',this)">
              </label>
              <% if (overrides[p.id] && overrides[p.id].image) { %>
              <button type="button" class="btn-admin ghost sm"
                onclick="removeBuiltinImage('<%= p.id %>',this.closest('.admin-product-card'))">✕ Img</button>
              <% } %>
              <button type="button" class="btn-admin danger sm"
                data-id="<%= p.id %>" data-name="<%= p.name %>"
                onclick="openBuiltinDelModal(this.dataset.id,this.dataset.name,this.closest('.admin-product-card'))">🗑</button>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
      <% } %>
      <% }); %>

    </div>
  </main>
</div>

<!-- Delete Custom Product Modal -->
<div class="admin-modal-overlay" id="delModal">
  <div class="admin-modal del-modal">
    <div class="del-modal-icon">🗑</div>
    <h3>Delete Product?</h3>
    <p><span class="del-modal-ref" id="delModalName"></span></p>
    <p class="del-modal-warn">This action is permanent and cannot be undone.</p>
    <div class="admin-modal-actions">
      <button class="btn-admin ghost" onclick="closeDelModal()">Cancel</button>
      <button class="btn-admin danger" id="delModalConfirm">Delete</button>
    </div>
  </div>
</div>
<!-- Delete Built-in Product Modal -->
<div class="admin-modal-overlay" id="builtinDelModal">
  <div class="admin-modal del-modal">
    <div class="del-modal-icon">🗑</div>
    <h3>Delete Built-in Product?</h3>
    <p><span class="del-modal-ref" id="builtinDelModalName"></span></p>
    <p class="del-modal-warn">This product will be permanently removed from the catalog.</p>
    <div class="admin-modal-actions">
      <button class="btn-admin ghost" onclick="closeBuiltinDelModal()">Cancel</button>
      <button class="btn-admin danger" id="builtinDelModalConfirm">Delete</button>
    </div>
  </div>
</div>

<script>
function filterCards() {
  const q = document.getElementById('searchInput').value.toLowerCase();
  document.querySelectorAll('.product-card').forEach(c => {
    c.style.display = c.dataset.search.includes(q) ? '' : 'none';
  });
}

function removeCard(card) {
  card.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
  card.style.opacity = '0';
  card.style.transform = 'scale(0.9)';
  setTimeout(() => card.remove(), 260);
}

async function deleteItem(url, card, closeModal) {
  closeModal();
  try {
    const res = await fetch(url, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
    if (res.ok) { removeCard(card); } else { location.reload(); }
  } catch { location.reload(); }
}

// ── Custom product delete ────────────────────
let _delCard = null, _delUrl = '';
function openDelModal(id, name, card) {
  _delCard = card; _delUrl = '/admin/products/' + id + '/delete';
  document.getElementById('delModalName').textContent = name;
  document.getElementById('delModal').classList.add('open');
}
function closeDelModal() { document.getElementById('delModal').classList.remove('open'); }
document.getElementById('delModalConfirm').addEventListener('click', () => deleteItem(_delUrl, _delCard, closeDelModal));
document.getElementById('delModal').addEventListener('click', function(e) { if (e.target === this) closeDelModal(); });

// ── Built-in product image upload/remove ────
async function uploadBuiltinImage(id, input) {
  if (!input.files[0]) return;
  const card = input.closest('.admin-product-card');
  const formData = new FormData();
  formData.append('image', input.files[0]);
  try {
    const res = await fetch('/admin/products/builtin/' + id + '/image', {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
      body: formData,
    });
    const data = await res.json();
    if (data.success) {
      const visual = card.querySelector('.apc-visual');
      let img = visual.querySelector('img');
      if (!img) {
        img = document.createElement('img');
        img.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover';
        const emoji = visual.querySelector('.builtin-emoji');
        if (emoji) emoji.style.display = 'none';
        visual.appendChild(img);
      }
      img.src = data.image;
      const actions = card.querySelector('.apc-actions');
      if (!actions.querySelector('.remove-img-btn')) {
        const btn = document.createElement('button');
        btn.type = 'button'; btn.className = 'btn-admin ghost sm remove-img-btn';
        btn.textContent = '✕ Img';
        btn.onclick = () => removeBuiltinImage(id, card);
        actions.insertBefore(btn, actions.children[1]);
      }
    }
  } catch { alert('Upload failed.'); }
}

async function removeBuiltinImage(id, card) {
  try {
    const res = await fetch('/admin/products/builtin/' + id + '/image/remove', {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
    });
    const data = await res.json();
    if (data.success) {
      const visual = card.querySelector('.apc-visual');
      const img = visual.querySelector('img');
      if (img) img.remove();
      const emoji = visual.querySelector('.builtin-emoji');
      if (emoji) emoji.style.display = '';
      const removeBtn = card.querySelector('.remove-img-btn');
      if (removeBtn) removeBtn.remove();
    }
  } catch { alert('Remove failed.'); }
}

// ── Built-in product delete ──────────────────
let _builtinDelCard = null, _builtinDelUrl = '';
function openBuiltinDelModal(id, name, card) {
  _builtinDelCard = card; _builtinDelUrl = '/admin/products/builtin/' + id + '/delete';
  document.getElementById('builtinDelModalName').textContent = name;
  document.getElementById('builtinDelModal').classList.add('open');
}
function closeBuiltinDelModal() { document.getElementById('builtinDelModal').classList.remove('open'); }
document.getElementById('builtinDelModalConfirm').addEventListener('click', () => deleteItem(_builtinDelUrl, _builtinDelCard, closeBuiltinDelModal));
document.getElementById('builtinDelModal').addEventListener('click', function(e) { if (e.target === this) closeBuiltinDelModal(); });
</script>
</body>
</html>
