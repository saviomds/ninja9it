<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body class="page-install">

<%- include('partials/navbar') %>

<main class="install-page">

  <!-- HERO -->
  <section class="inst-hero">
    <div class="inst-hero-glow"></div>
    <div class="inst-hero-inner">
      <div class="inst-app-icon-wrap">
        <img src="/logo.jpg" alt="Ninja9IT" class="inst-app-icon" />
        <div class="inst-icon-ring r1"></div>
        <div class="inst-icon-ring r2"></div>
      </div>
      <div class="inst-hero-text">
        <div class="inst-label">// FREE APP</div>
        <h1>NINJA<span>9</span>IT</h1>
        <p>Stealth Drinks Delivery · Mauritius 🇲🇺</p>
        <div class="inst-badges">
          <span>⚡ 30-Min Delivery</span>
          <span>📴 Works Offline</span>
          <span>🚫 No App Store</span>
        </div>
      </div>
    </div>
  </section>

  <!-- MAIN CONTENT -->
  <div class="inst-body">

    <!-- QR + SHARE -->
    <div class="inst-qr-card">
      <div class="inst-qr-wrap">
        <canvas id="qrCanvas"></canvas>
        <div class="inst-qr-label">Scan to install</div>
      </div>

      <div class="inst-share-col">
        <h3>Share this app</h3>
        <p class="inst-share-sub">Send the install link to anyone, anywhere.</p>

        <div class="inst-url-copy">
          <span id="appUrlDisplay"><%= appUrl %>/install</span>
          <button id="copyLinkBtn" class="inst-copy-btn" title="Copy link">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
            Copy
          </button>
        </div>

        <div class="inst-share-btns">
          <a id="whatsappShareBtn" href="#" target="_blank" class="inst-share-btn wa">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
          <a id="telegramShareBtn" href="#" target="_blank" class="inst-share-btn tg">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
            Telegram
          </a>
          <button id="smsShareBtn" class="inst-share-btn sms">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
            SMS
          </button>
          <button id="nativeShareBtn" class="inst-share-btn native" style="display:none">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            Share
          </button>
        </div>
      </div>
    </div>

    <!-- PLATFORM TABS -->
    <div class="inst-platform-section">
      <h2 class="inst-section-title">How to Install</h2>
      <div class="inst-tabs">
        <button class="inst-tab active" data-tab="android">🤖 Android</button>
        <button class="inst-tab" data-tab="ios">🍎 iPhone / iPad</button>
        <button class="inst-tab" data-tab="desktop">💻 Desktop</button>
      </div>

      <!-- Android -->
      <div class="inst-tab-panel active" id="tab-android">
        <div class="inst-steps">
          <div class="inst-step">
            <div class="inst-step-num">1</div>
            <div class="inst-step-body">
              <strong>Open Chrome</strong>
              <p>On your Android phone, open <b>Google Chrome</b> browser.</p>
            </div>
          </div>
          <div class="inst-step">
            <div class="inst-step-num">2</div>
            <div class="inst-step-body">
              <strong>Go to the site</strong>
              <p>Visit <code><%= appUrl %></code> or scan the QR code above.</p>
            </div>
          </div>
          <div class="inst-step">
            <div class="inst-step-num">3</div>
            <div class="inst-step-body">
              <strong>Tap Install banner</strong>
              <p>A banner saying <b>"Install Ninja9IT"</b> will appear at the bottom. Tap <b>Install</b>.</p>
            </div>
          </div>
          <div class="inst-step">
            <div class="inst-step-num">4</div>
            <div class="inst-step-body">
              <strong>Or use the menu</strong>
              <p>Tap the <b>⋮ three-dot menu → Add to Home Screen</b> if the banner doesn't show.</p>
            </div>
          </div>
          <div class="inst-step done">
            <div class="inst-step-num">✓</div>
            <div class="inst-step-body">
              <strong>Done!</strong>
              <p>Ninja9IT is now on your home screen. Tap the icon to open it like any app.</p>
            </div>
          </div>
        </div>
        <div class="inst-alt-box">
          <span class="inst-alt-icon">📦</span>
          <div>
            <strong>Want a real .APK file?</strong>
            <p>See the <a href="#apk-section">APK Generator</a> section below to build a native Android package you can share directly via WhatsApp, Telegram, or USB.</p>
          </div>
        </div>
      </div>

      <!-- iOS -->
      <div class="inst-tab-panel" id="tab-ios">
        <div class="inst-steps">
          <div class="inst-step">
            <div class="inst-step-num">1</div>
            <div class="inst-step-body">
              <strong>Open Safari</strong>
              <p>On your iPhone or iPad, open <b>Safari</b> — it must be Safari, not Chrome.</p>
            </div>
          </div>
          <div class="inst-step">
            <div class="inst-step-num">2</div>
            <div class="inst-step-body">
              <strong>Visit the site</strong>
              <p>Go to <code><%= appUrl %></code> or scan the QR code above.</p>
            </div>
          </div>
          <div class="inst-step">
            <div class="inst-step-num">3</div>
            <div class="inst-step-body">
              <strong>Tap the Share button</strong>
              <p>Tap the <b>⬆ Share</b> icon at the bottom of the screen (or top on iPad).</p>
            </div>
          </div>
          <div class="inst-step">
            <div class="inst-step-num">4</div>
            <div class="inst-step-body">
              <strong>Add to Home Screen</strong>
              <p>Scroll down and tap <b>"Add to Home Screen"</b>, then tap <b>Add</b>.</p>
            </div>
          </div>
          <div class="inst-step done">
            <div class="inst-step-num">✓</div>
            <div class="inst-step-body">
              <strong>Done!</strong>
              <p>Ninja9IT appears on your home screen and opens full-screen like a native app.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Desktop -->
      <div class="inst-tab-panel" id="tab-desktop">
        <div class="inst-steps">
          <div class="inst-step">
            <div class="inst-step-num">1</div>
            <div class="inst-step-body">
              <strong>Open Chrome or Edge</strong>
              <p>Works on Windows, Mac, and Linux with Google Chrome or Microsoft Edge.</p>
            </div>
          </div>
          <div class="inst-step">
            <div class="inst-step-num">2</div>
            <div class="inst-step-body">
              <strong>Visit the site</strong>
              <p>Go to <code><%= appUrl %></code> in your browser.</p>
            </div>
          </div>
          <div class="inst-step">
            <div class="inst-step-num">3</div>
            <div class="inst-step-body">
              <strong>Click the install icon</strong>
              <p>Look for a <b>⊕ install icon</b> in the address bar (right side). Click it.</p>
            </div>
          </div>
          <div class="inst-step">
            <div class="inst-step-num">4</div>
            <div class="inst-step-body">
              <strong>Click Install</strong>
              <p>A dialog appears — click <b>Install</b>. The app opens in its own window.</p>
            </div>
          </div>
          <div class="inst-step done">
            <div class="inst-step-num">✓</div>
            <div class="inst-step-body">
              <strong>Done!</strong>
              <p>Ninja9IT is pinned to your taskbar / dock and opens like a desktop app.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- APK SECTION -->
    <div class="inst-apk-section" id="apk-section">
      <div class="inst-apk-head">
        <span class="inst-apk-icon">📦</span>
        <div>
          <h2>Generate a Real Android APK</h2>
          <p>Package Ninja9IT as a native .apk file — shareable via WhatsApp, USB, or any file link.</p>
        </div>
      </div>

      <div class="inst-apk-steps">
        <div class="inst-apk-step">
          <div class="inst-apk-step-num">1</div>
          <div>
            <strong>Go to PWABuilder</strong>
            <p>Visit <a href="https://www.pwabuilder.com" target="_blank" rel="noopener">pwabuilder.com</a> — Microsoft's free PWA packaging tool.</p>
          </div>
        </div>
        <div class="inst-apk-step">
          <div class="inst-apk-step-num">2</div>
          <div>
            <strong>Enter your site URL</strong>
            <p>Paste <code><%= appUrl %></code> into the box and click Start.</p>
          </div>
        </div>
        <div class="inst-apk-step">
          <div class="inst-apk-step-num">3</div>
          <div>
            <strong>Choose Android → Download</strong>
            <p>Select the <b>Android</b> platform, click <b>Download Package</b>. You get a signed .apk + .aab.</p>
          </div>
        </div>
        <div class="inst-apk-step">
          <div class="inst-apk-step-num">4</div>
          <div>
            <strong>Share the APK anywhere</strong>
            <p>Send via WhatsApp, Telegram, Google Drive, or upload to any file host. Recipients install it directly — no Play Store needed.</p>
          </div>
        </div>
      </div>

      <div class="inst-apk-cta">
        <a href="https://www.pwabuilder.com" target="_blank" rel="noopener" class="inst-apk-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          Open PWABuilder
        </a>
        <span class="inst-apk-note">Free · No account required · Takes ~2 minutes</span>
      </div>
    </div>

  </div><!-- /inst-body -->
</main>

<%- include('partials/footer') %>
<%- include('partials/callwidget') %>

<script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>
<script>
(function () {
  var APP_URL = '<%= appUrl %>/install';

  /* ── QR Code ── */
  QRCode.toCanvas(document.getElementById('qrCanvas'), APP_URL, {
    width: 180,
    margin: 2,
    color: { dark: '#ffffff', light: '#111111' }
  });

  /* ── Share links ── */
  var msg = encodeURIComponent('Install Ninja9IT – Stealth Drinks Delivery 🥷🇲🇺 ' + APP_URL);

  var wa = document.getElementById('whatsappShareBtn');
  if (wa) wa.href = 'https://wa.me/?text=' + msg;

  var tg = document.getElementById('telegramShareBtn');
  if (tg) tg.href = 'https://t.me/share/url?url=' + encodeURIComponent(APP_URL) + '&text=' + encodeURIComponent('Install Ninja9IT 🥷');

  var sms = document.getElementById('smsShareBtn');
  if (sms) sms.addEventListener('click', function () {
    window.location.href = 'sms:?body=' + msg;
  });

  /* Native Share API */
  var nativeBtn = document.getElementById('nativeShareBtn');
  if (navigator.share) {
    nativeBtn.style.display = 'flex';
    nativeBtn.addEventListener('click', function () {
      navigator.share({
        title: 'Ninja9IT App',
        text: 'Install Ninja9IT – Stealth Drinks Delivery across Mauritius 🥷',
        url: APP_URL
      }).catch(function () {});
    });
  }

  /* ── Copy link ── */
  var copyBtn = document.getElementById('copyLinkBtn');
  if (copyBtn) copyBtn.addEventListener('click', function () {
    navigator.clipboard.writeText(APP_URL).then(function () {
      copyBtn.innerHTML = '✓ Copied!';
      copyBtn.classList.add('copied');
      setTimeout(function () {
        copyBtn.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg> Copy';
        copyBtn.classList.remove('copied');
      }, 2200);
    }).catch(function () {
      copyBtn.textContent = 'Copy link';
    });
  });

  /* ── Platform tabs ── */
  var tabs   = document.querySelectorAll('.inst-tab');
  var panels = document.querySelectorAll('.inst-tab-panel');
  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      tabs.forEach(function (t) { t.classList.remove('active'); });
      panels.forEach(function (p) { p.classList.remove('active'); });
      tab.classList.add('active');
      var panel = document.getElementById('tab-' + tab.dataset.tab);
      if (panel) panel.classList.add('active');
    });
  });

  /* ── Auto-detect platform and activate correct tab ── */
  var ua = navigator.userAgent;
  if (/iphone|ipad|ipod/i.test(ua)) {
    document.querySelector('[data-tab="ios"]').click();
  } else if (!/android/i.test(ua) && !/mobile/i.test(ua)) {
    document.querySelector('[data-tab="desktop"]').click();
  }
})();
</script>
<script src="/js/main.js"></script>
</body>
</html>
