<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body class="page-inner">

<%- include('partials/navbar') %>

<!-- PAGE HERO -->
<section class="page-hero">
  <div class="page-hero-glow"></div>
  <div class="page-hero-content">
    <div class="section-label">// MISSION BRIEFING</div>
    <h1>Our <span class="red-text">Services</span></h1>
    <p>Ninja precision. Every time. Everywhere in Mauritius.</p>
  </div>
</section>

<!-- SERVICES GRID -->
<section class="section-dark">
  <div class="section-inner">
    <div class="section-label reveal">// WHAT WE OFFER</div>
    <h2 class="section-heading reveal">Why Choose <span class="red-text">Ninja9IT?</span></h2>
    <p class="section-sub reveal">We operate with ninja precision — fast, discreet, and always on target.</p>

    <div class="services-grid">
      <div class="svc-card reveal">
        <div class="svc-icon">⚡</div>
        <h3>Ninja Fast Delivery</h3>
        <p>30-minute delivery to your door across all major areas. We don't believe in waiting — neither should you.</p>
        <div class="svc-stat">Avg. 28 min delivery</div>
      </div>
      <div class="svc-card reveal featured-svc">
        <div class="svc-icon">🔒</div>
        <h3>Discreet &amp; 100% Secure</h3>
        <p>Stealth packaging every single time. Your order is your business. We never compromise your privacy.</p>
        <div class="svc-stat">100% private packaging</div>
        <div class="featured-pill">Most Popular</div>
      </div>
      <div class="svc-card reveal">
        <div class="svc-icon">🍾</div>
        <h3>Premium Selection</h3>
        <p>From Grey Goose to Chamarel Rum. Local legends to global imports. 200+ curated options available now.</p>
        <div class="svc-stat">200+ drinks available</div>
      </div>
      <div class="svc-card reveal">
        <div class="svc-icon">📍</div>
        <h3>Island-Wide Coverage</h3>
        <p>Every major district in Mauritius covered. Port Louis, Grand Baie, Mahebourg, Le Morne — we go everywhere.</p>
        <div class="svc-stat">All 12 major districts</div>
      </div>
      <div class="svc-card reveal">
        <div class="svc-icon">🌙</div>
        <h3>Reliable 24/7</h3>
        <p>We operate 24 hours a day, 7 days a week, 365 days a year. Midnight craving? 3am party? We've got you.</p>
        <div class="svc-stat">Always available</div>
      </div>
      <div class="svc-card reveal">
        <div class="svc-icon">💳</div>
        <h3>Flexible Payment</h3>
        <p>Cash on delivery, card payment, or Juice Money. Pay your way — always fast and hassle-free.</p>
        <div class="svc-stat">3 payment methods</div>
      </div>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section>
  <div class="section-inner">
    <div class="section-label reveal">// THE PROCESS</div>
    <h2 class="section-heading reveal">How It <span class="red-text">Works</span></h2>

    <div class="process-steps">
      <div class="process-step reveal">
        <div class="ps-num">01</div>
        <div class="ps-icon">📱</div>
        <h3>Browse Menu</h3>
        <p>Choose from 200+ premium drinks — beers, spirits, wines, cocktails, and softs. Find your perfect order.</p>
      </div>
      <div class="ps-connector reveal"></div>
      <div class="process-step reveal">
        <div class="ps-num">02</div>
        <div class="ps-icon">🛒</div>
        <h3>Add to Cart &amp; Order</h3>
        <p>Add drinks to your cart, fill in your delivery details, and choose how you want to pay. Takes 2 minutes.</p>
      </div>
      <div class="ps-connector reveal"></div>
      <div class="process-step reveal">
        <div class="ps-num">03</div>
        <div class="ps-icon">✅</div>
        <h3>Confirm &amp; Wait</h3>
        <p>We confirm your order by phone. Our ninja is dispatched immediately. Track your delivery in real-time.</p>
      </div>
      <div class="ps-connector reveal"></div>
      <div class="process-step reveal">
        <div class="ps-num">04</div>
        <div class="ps-icon">🥷</div>
        <h3>Ninja Arrives</h3>
        <p>Your drinks arrive in 30 minutes, discreetly packaged, cold and ready. Enjoy. That's the ninja way.</p>
      </div>
    </div>
  </div>
</section>

<!-- GUARANTEES -->
<section class="section-dark">
  <div class="section-inner">
    <div class="section-label reveal">// OUR PROMISE</div>
    <h2 class="section-heading reveal">The Ninja <span class="red-text">Guarantee</span></h2>

    <div class="guarantee-grid">
      <div class="guarantee-card reveal">
        <div class="g-icon">⏱️</div>
        <h3>30-Minute Promise</h3>
        <p>If we're late, your next delivery fee is waived. No excuses. No delays. That's our commitment.</p>
      </div>
      <div class="guarantee-card reveal">
        <div class="g-icon">🍹</div>
        <h3>Quality Guaranteed</h3>
        <p>Every product is authentic, properly stored, and delivered at the right temperature. Always.</p>
      </div>
      <div class="guarantee-card reveal">
        <div class="g-icon">🔞</div>
        <h3>18+ Verification</h3>
        <p>We verify age at delivery. We operate responsibly and comply with all Mauritius regulations.</p>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section>
  <div class="section-inner">
    <div class="section-label reveal">// FAQ</div>
    <h2 class="section-heading reveal">Common <span class="red-text">Questions</span></h2>

    <div class="faq-list">
      <div class="faq-item reveal">
        <button class="faq-q">How fast is the delivery? <span>+</span></button>
        <div class="faq-a">Our average delivery time is 28 minutes. We guarantee delivery within 30 minutes for most areas in Mauritius.</div>
      </div>
      <div class="faq-item reveal">
        <button class="faq-q">Which areas do you deliver to? <span>+</span></button>
        <div class="faq-a">We cover all major districts: Port Louis, Quatre Bornes, Curepipe, Rose Hill, Vacoas, Flic en Flac, Grand Baie, Mahebourg, Moka, Beau Bassin, Triolet, and Le Morne.</div>
      </div>
      <div class="faq-item reveal">
        <button class="faq-q">Is the packaging really discreet? <span>+</span></button>
        <div class="faq-a">Absolutely. All orders arrive in plain, unmarked packaging. No branding on the outside. Total privacy, every time.</div>
      </div>
      <div class="faq-item reveal">
        <button class="faq-q">What payment methods do you accept? <span>+</span></button>
        <div class="faq-a">We accept cash on delivery, debit/credit card, and Juice Money (MCB). All transactions are secure.</div>
      </div>
      <div class="faq-item reveal">
        <button class="faq-q">Do you operate on public holidays? <span>+</span></button>
        <div class="faq-a">Yes! We operate 24/7, 365 days a year — including all public holidays. No day off for ninjas.</div>
      </div>
      <div class="faq-item reveal">
        <button class="faq-q">Is there a minimum order? <span>+</span></button>
        <div class="faq-a">No minimum order. Order one can or a full party setup — we deliver it all the same way.</div>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-banner">
  <div class="cta-banner-glow"></div>
  <div class="cta-banner-inner reveal">
    <h2>Ready to Experience <span class="red-text">Ninja Delivery?</span></h2>
    <p>Order now and get your drinks in 30 minutes.</p>
    <a href="/menu" class="btn-primary btn-large">Browse Menu →</a>
  </div>
</section>

<%- include('partials/footer') %>
<%- include('partials/callwidget') %>
<script>const SHOW_LOADER = false;</script>
<script src="/js/main.js"></script>
</body>
</html>
