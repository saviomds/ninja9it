<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body class="page-inner auth-page">

<%- include('partials/splash') %>
<%- include('partials/navbar') %>

<section class="auth-section">
  <div class="auth-card auth-card--wide">

    <div class="auth-logo">
      <img src="/logo.jpg" alt="Ninja9IT" />
      <h1>NINJA<em>9</em>IT</h1>
      <p>Join the shadow network — 48-hour access.</p>
    </div>

    <% if (error) { %>
    <div class="auth-alert auth-alert--error"><span>✕</span> <%= error %></div>
    <% } %>

    <form class="auth-form" method="POST" action="/register">

      <!-- Avatar Picker -->
      <div class="avatar-picker-wrap">
        <label class="avatar-picker-label">Choose your avatar</label>
        <div class="avatar-grid">
          <% const avatars = ['🥷','😎','🦊','🐱','🐉','🦁','🐺','🐸','🤖','👾','🦅','🐯',
            '🧑🏻','🧑🏽','🧑🏾','🧑🏿','👨🏻','👨🏽','👨🏾','👨🏿','👩🏻','👩🏽','👩🏾','👩🏿']; %>
          <% avatars.forEach(function(av){ %>
          <button type="button" class="av-opt" data-av="<%= av %>"><%= av %></button>
          <% }); %>
        </div>
        <input type="hidden" name="avatar" id="avatarInput" value="🥷" />
        <div class="av-preview-row">
          <div class="av-preview" id="avPreview">🥷</div>
          <span class="av-preview-hint">Selected avatar</span>
        </div>
      </div>

      <div class="auth-row">
        <div class="auth-group">
          <label>Username</label>
          <input type="text" name="username" placeholder="3–20 chars, letters / numbers"
            required autofocus autocomplete="username"
            pattern="[a-zA-Z0-9_]{3,20}" title="3–20 chars: letters, numbers, underscores only" />
        </div>
        <div class="auth-group">
          <label>Email</label>
          <input type="email" name="email" placeholder="your@email.com"
            required autocomplete="email" />
        </div>
      </div>
      <div class="auth-row">
        <div class="auth-group">
          <label>Password</label>
          <div class="pw-wrap">
            <input type="password" name="password" id="regPassword" placeholder="Min. 6 characters"
              required autocomplete="new-password" minlength="6" />
            <button type="button" class="pw-toggle" aria-label="Show password" tabindex="-1">👁</button>
          </div>
          <div class="pw-strength-bar" id="pwStrengthBar"><div class="pw-strength-fill" id="pwStrengthFill"></div></div>
          <span class="pw-strength-label" id="pwStrengthLabel"></span>
        </div>
        <div class="auth-group">
          <label>Confirm Password</label>
          <div class="pw-wrap">
            <input type="password" name="confirm" id="regConfirm" placeholder="Repeat password"
              required autocomplete="new-password" />
            <button type="button" class="pw-toggle" aria-label="Show password" tabindex="-1">👁</button>
          </div>
          <span class="pw-match-hint" id="pwMatchHint"></span>
        </div>
      </div>

      <button type="submit" class="auth-btn" id="registerBtn">
        <span>Join the Dojo</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </button>
    </form>

    <div class="auth-perks">
      <div class="auth-perk"><span>⏱</span> 48-hour account</div>
      <div class="auth-perk"><span>🔒</span> Secure session</div>
      <div class="auth-perk"><span>📁</span> Personal folder</div>
      <div class="auth-perk"><span>🥷</span> Instant access</div>
    </div>

    <div class="auth-divider"></div>
    <p class="auth-switch">Already a ninja? <a href="/login">Sign in →</a></p>

  </div>
</section>

<% if (locals.success) { %>
<div class="auth-success-overlay" id="registerSuccess">
  <div class="auth-success-card">
    <span class="asc-avatar"><%= locals.welcomeAvatar || '🥷' %></span>
    <span class="asc-tick">🎉</span>
    <h2>Ninja account ready, <span><%= locals.welcomeUser || '' %></span>!</h2>
    <p class="asc-sub">You've joined the shadow network. Here's your briefing:</p>
    <div class="asc-guide">
      <div class="asc-guide-item">🍺 Browse 200+ drinks and place your first order</div>
      <div class="asc-guide-item">📍 Track your delivery in real-time</div>
      <div class="asc-guide-item">⏳ Account active for 48 hours — use it wisely</div>
    </div>
    <p class="asc-redirect">Taking you to home base…</p>
    <div class="asc-bar"><div class="asc-bar-fill" id="ascFill"></div></div>
  </div>
</div>
<script>
(function(){
  var fill = document.getElementById('ascFill');
  var start = Date.now(), dur = 3200;
  function tick() {
    var p = Math.min(100, (Date.now()-start)/dur*100);
    fill.style.width = p + '%';
    if (p < 100) requestAnimationFrame(tick);
    else window.location.href = '/';
  }
  requestAnimationFrame(tick);
})();
</script>
<% } %>

<%- include('partials/footer') %>
<%- include('partials/callwidget') %>
<script src="/js/main.js"></script>
<script>
(function(){
  const opts    = document.querySelectorAll('.av-opt');
  const input   = document.getElementById('avatarInput');
  const preview = document.getElementById('avPreview');

  // Mark first option (🥷) as selected by default
  if (opts[0]) opts[0].classList.add('av-opt--selected');

  opts.forEach(btn => {
    btn.addEventListener('click', function(){
      opts.forEach(b => b.classList.remove('av-opt--selected'));
      this.classList.add('av-opt--selected');
      input.value   = this.dataset.av;
      preview.textContent = this.dataset.av;
    });
  });
})();
</script>
</body>
</html>
